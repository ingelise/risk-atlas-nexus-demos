# Anthropic API Key
# Get one from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-...

# MCP Server Configuration
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Optional: Database for persistent coverage state
# DATABASE_URL=postgresql://user:password@localhost:5432/redteam_db

# Optional: Ticketing system integration
# JIRA_URL=https://jira.company.com
# JIRA_API_KEY=...
# JIRA_PROJECT=SECURITY

# Optional: Model override (if not using claude-opus-4-8)
# MODEL=claude-sonnet-5
